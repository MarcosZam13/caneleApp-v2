# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — TODOS los .env se ignoran excepto .env.example
.env*
!.env.example

# keys, certificados y credenciales
*.pem
*.p8
*.key
*.pfx
credentials*.json
service-account*.json
*-secrets*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local
supabase/.temp/
supabase/config.toml

# archivos de contexto del asistente — no son parte del código de la app
AGENTS.md
PLAN-MEJORAS.md
opencode.jsonc
skills-lock.json
docs/mapa-mejoras.md
docs/plan-deploy-mejoras.md

# skills y config de agentes — específicos del entorno local
.agents/
.claude/
